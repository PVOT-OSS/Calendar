<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <EditText
        android:id="@+id/quick_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/quick_create_title_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:minHeight="56dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_baseline_calendar_today"
            app:tint="?attr/colorOnSurfaceVariant"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/quick_when"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/quick_all_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingStart="40dp"
        android:text="@string/quick_create_all_day"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <Spinner
        android:id="@+id/quick_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:minHeight="48dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_more"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/quick_create_more" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_event_dialog_save" />
    </LinearLayout>
</LinearLayout>
