<!-- Lenia Sans for the View screens; the theme sets it as the default fontFamily. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/lenia_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/lenia_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/lenia_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/lenia_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
